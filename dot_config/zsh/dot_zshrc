# =============================================================================
# .zshrc
# 启动交互式 Zsh 实例时加载，是日常使用的核心配置
# =============================================================================

# 启用 Powerlevel10k 即时提示
() { [[ -r "$1" ]] && source "$1" } "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>>>>>>>>> 1. Shell 基础选项  <<<<<<<<<<
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
setopt autocd                   # 目录名自动 cd
setopt extendedglob             # 启用扩展通配符
setopt hist_ignore_dups         # [历史命令行为] 不连续重复地记录命令
setopt hist_ignore_space        # [历史命令行为] 不记录有前导空格的命令
setopt share_history            # [历史命令行为] 历史命令多终端窗口共享
setopt hist_expire_dups_first   # [历史命令行为] 历史重复条目优先过期 <<< add
setopt hist_reduce_blanks       # [历史命令行为] 存储前去除多余空格 <<< add
unsetopt beep                   # 关闭终端响铃

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>>>>>>>>> 2. 环境变量        <<<<<<<<<<
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
export MANPAGER='bat -plman --theme="Monokai Extended Light"'   # 将 bat 作为 man 的彩色分页器
export MANROFFOPT="-c"                                          # 修正 man 渲染器 SGR 输出以配合 bat

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>>>>>>>>> 3. 历史命令配置    <<<<<<<<<<
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
history_ignore_keywords=(       # 从历史记录和自动建议中过滤的关键词
    claude
)

HISTSIZE=5000                               # 内存保留历史命令的条目数
SAVEHIST=50000                              # 退出 Zsh 时最大的历史命令写入数
HISTFILE=~/.zsh_history                     # 历史命令持久化文件路径
HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1    # 历史搜索结果去重
ZSH_AUTOSUGGEST_HISTORY_IGNORE="*(${(j:|:)history_ignore_keywords})*"

function zshaddhistory() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  [[ $1 == ${~ZSH_AUTOSUGGEST_HISTORY_IGNORE} ]] && return 1
  return 0
}

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>>>>>>>>> 4. 插件加载        <<<<<<<<<<
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
eval "$(mise activate zsh)"     # 激活 mise（多种二进制工具的管理器）
source ${ZDOTDIR:-$HOME}/.antidote/antidote.zsh
antidote load ${ZDOTDIR:-$HOME}/.zsh_plugins.txt
YSU_MESSAGE_POSITION="after"    # 消息显示位置（MichaelAquilina/zsh-you-should-use）

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>>>>>>>>> 5. 补全系统初始化  <<<<<<<<<<
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
_cache_completion() {
    # 用法：_cache_completion <命令名> <生成补全脚本的命令...>
    emulate -L zsh  # 隔离函数内的 Zsh 选项

    local name="$1" # 待补全的命令名
    shift           # 以剩余参数作为补全脚本的生成命令

    local target="${SITE_FUNCTIONS}/_${name}"   # 目标补全文件名（以下划线开头）
    local tmp="${target}.tmp.$$"                # 临时文件名

    (( ${+commands[$name]} )) || return 0       # 待补全的命令不存在，跳过
    [[ -s "$target" ]] && return 0              # 已有非空的补全文件，跳过

    if command "$@" >| "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then  # 成功生成补全文件
        mv -f -- "$tmp" "$target"               # 替换为目标补全文件
    fi

    rm -f -- "$tmp" # 清理临时文件
}

mkdir -p -- "${SITE_FUNCTIONS}" "${ZSH_COMPDUMP:h}"  # 创建补全脚本及缓存目录

# mise 源
_cache_completion   mise            mise completion zsh
_cache_completion   bat             bat --completion zsh
_cache_completion   bun             bun completions zsh
_cache_completion   delta           delta --generate-completion zsh
_cache_completion   fd              fd --gen-completions zsh
_cache_completion   gh              gh completion -s zsh
_cache_completion   lazygit         lazygit completion zsh
_cache_completion   opencode        opencode completion
_cache_completion   openspec        openspec completion generate zsh
_cache_completion   pnpm            pnpm completion zsh
_cache_completion   rg              rg --generate complete-zsh
_cache_completion   tldr            curl -fsSL -m 5 --connect-timeout 2 https://github.com/tealdeer-rs/tealdeer/releases/latest/download/completions_zsh
_cache_completion   tree-sitter     tree-sitter complete --shell zsh
_cache_completion   uv              uv generate-shell-completion zsh
_cache_completion   uvx             uvx --generate-shell-completion zsh
_cache_completion   yq              yq shell-completion zsh
# apt 源
_cache_completion   caddy           caddy completion zsh
_cache_completion   chezmoi         chezmoi completion zsh
_cache_completion   podman          podman completion zsh
_cache_completion   tailscale       tailscale completion zsh

disabled_command_completions=(  # 禁用专属补全的命令列表
    tree
)

autoload -Uz compinit
compinit -d "${ZSH_COMPDUMP}"
compdef -d "${disabled_command_completions[@]}"
unfunction _cache_completion

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>>>>>>>>> 6. 按键绑定        <<<<<<<<<<
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
bindkey -e                      # 将 Zsh 的键位方案设置为 Emacs 模式

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>>>>>>>>> 7. 工具初始化      <<<<<<<<<<
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
eval "$(zoxide init zsh)"       # 初始化 zoxide
source <(fzf --zsh)             # 初始化 fzf

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>>>>>>>>> 8. 提示符          <<<<<<<<<<
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
[[ -f $ZDOTDIR/.p10k.zsh ]] && source $ZDOTDIR/.p10k.zsh  # 加载 Powerlevel10k 配置

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>>>>>>>>> 9. 别名            <<<<<<<<<<
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
alias -g -- --help='--help |& bat -plhelp --theme="Monokai Extended Light"'  # 使用 bat 高亮显示 --help 信息
alias lg='lazygit'              # 打开 lazygit TUI

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>>>>>>>>> 10. 自定义函数     <<<<<<<<<<
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
