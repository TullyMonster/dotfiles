# =============================================================================
# .zprofile
# SSH/TTY 登录 Zsh 首次会话时，读取 .zshenv 之后、.zshrc 之前加载
#
# 适合写入：
#   - 每次登录只需执行一次的初始化任务
#   - 依赖登录环境的路径补充
#   - 图形会话变量
# =============================================================================

eval "$(mise activate zsh --shims)"  # 设置 mise shims，保证在非交互登录 shell（IDE、cron 等）时也能使用 mise 管理的工具
