# 建议仅在回环地址监听服务端口
# 如需远程访问 noVNC，请在宿主机用 Tailscale Serve 暴露

BROWSER_PROFILE_DIR={{ $.headed_playwright_service.profile_dir }}

DISPLAY={{ $.headed_playwright_service.x11_display }}
XVFB_WHD={{ $.headed_playwright_service.xvfb_whd }}

MCP_HOST=127.0.0.1
MCP_PORT={{ $.headed_playwright_service.mcp_port }}
MCP_ALLOWED_HOSTS={{ printf "localhost,127.0.0.1,localhost:%s,127.0.0.1:%s" $.headed_playwright_service.mcp_port $.headed_playwright_service.mcp_port }}

VNC_HOST=127.0.0.1
VNC_PORT={{ $.headed_playwright_service.vnc_port }}

NOVNC_HOST=127.0.0.1
NOVNC_PORT={{ $.headed_playwright_service.novnc_port }}

ENDPOINT_HOST=127.0.0.1
ENDPOINT_PORT={{ $.headed_playwright_service.endpoint_port }}
ENDPOINT_FILE=/run/headed-playwright-service/ws-endpoint
ENDPOINT_WAIT_SECONDS=30
