#!/usr/bin/env sh
set -eu

: "${MCP_HOST:?MCP_HOST is required}"
: "${MCP_PORT:?MCP_PORT is required}"
: "${MCP_ALLOWED_HOSTS:?MCP_ALLOWED_HOSTS is required}"
: "${MCP_USER_DATA_DIR:?MCP_USER_DATA_DIR is required}"
: "${DISPLAY:?DISPLAY is required}"

mkdir -p "${MCP_USER_DATA_DIR}"

exec playwright-mcp \
  --host "${MCP_HOST}" \
  --port "${MCP_PORT}" \
  --allowed-hosts "${MCP_ALLOWED_HOSTS}" \
  --user-data-dir "${MCP_USER_DATA_DIR}" \
  --browser chromium \
  --shared-browser-context \
  --output-mode stdout \
  --no-sandbox
