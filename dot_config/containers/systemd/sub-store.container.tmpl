[Unit]
Description=Sub-Store
Documentation=https://sub-store-org.github.io/doc/
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/xream/sub-store:http-meta
ContainerName=sub-store
PublishPort=127.0.0.1:3001:3001
Volume=sub_store_data:/opt/app/data:Z
Environment=SUB_STORE_FRONTEND_BACKEND_PATH={{ .sub_store.backend_path  }}
Environment="SUB_STORE_BACKEND_SYNC_CRON=55 23 * * *"
SecurityLabelDisable=false
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
