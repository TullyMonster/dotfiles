#!/usr/bin/env sh
#MISE description="Update TPM"
#MISE alias="tpm-update"

set -eu

tpm_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tpm"

if [ ! -d "$tpm_dir/.git" ]; then
  printf '%s\n' "[error] TPM is not installed: $tpm_dir" >&2
  printf '%s\n' "Run chezmoi apply first." >&2
  exit 1
fi

git -C "$tpm_dir" pull --ff-only
