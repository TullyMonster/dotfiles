#!/usr/bin/env sh

set -eu

managed=$(
  cat << 'EOF'
{{ if index .openchamber "settings" }}{{ .openchamber.settings | toJson }}{{ else }}{}{{ end }}
EOF
)

current=$(cat)
[ -n "${current}" ] || current='{}'

if ! printf '%s' "${current}" | jq -e 'type == "object"' > /dev/null 2>&1; then
  printf '%s' "${current}"
  echo 'openchamber: {{ .chezmoi.targetFile | replace .chezmoi.homeDir "~" }} 不是对象' >&2
  exit 0
fi

merged=$(printf '%s' "${current}" | jq --argjson managed "${managed}" '
  def deepmerge($new):
    if type == "object" and ($new | type) == "object" then
      reduce ($new | to_entries[]) as $e (.; .[$e.key] |= deepmerge($e.value))
    else $new end;
  deepmerge($managed)
')

if printf '%s' "${current}" | jq -e --argjson merged "${merged}" '. == $merged' > /dev/null 2>&1; then
  printf '%s' "${current}"
else
  printf '%s' "${merged}"
fi
