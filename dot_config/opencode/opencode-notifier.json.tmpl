{
  "sound": false,
  "notification": false,
  "bell": false,
  "timeout": 5,
  "showProjectName": true,
  "showFullPath": false,
  "showSessionTitle": true,
  "showIcon": false,
  "customIconPath": null,
  "suppressWhenFocused": false,
  "enableOnDesktop": false,
  "notificationSystem": "osascript",
  "suppressGhosttySound": false,
  "linux": {
    "grouping": false
  },
  "minDuration": 0,
  "command": {
    "enabled": true,
    "path": {{ printf "%s/.local/share/mise/shims/ntfy" .chezmoi.homeDir | quote }},
    "args": [
      "publish",
      "--quiet",
      "--markdown",
      "--icon",
      "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/opencode.png",
      "--title",
      "OpenCode: {event} in {projectName}",
      "opencode",
      "**{message}**\n\n- **事件**：`{event}`\n- **项目**：`{projectName}`\n- **会话**：{sessionTitle}\n- **代理**：`{agentName}`\n- **时间**：`{timestamp}`\n- **轮次**：`{turn}`"
    ],
    "minDuration": 0
  },
  "events": {
    "permission": {
      "sound": false,
      "notification": false,
      "command": true,
      "bell": false
    },
    "complete": {
      "sound": false,
      "notification": false,
      "command": true,
      "bell": false
    },
    "subagent_complete": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "error": {
      "sound": false,
      "notification": false,
      "command": true,
      "bell": false
    },
    "question": {
      "sound": false,
      "notification": false,
      "command": true,
      "bell": false
    },
    "user_cancelled": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "plan_exit": {
      "sound": false,
      "notification": false,
      "command": true,
      "bell": false
    },
    "session_started": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "user_message": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "client_connected": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    }
  },
  "messages": {
    "permission": "Permission required: {sessionTitle}",
    "complete": "Task completed: {sessionTitle}",
    "subagent_complete": "Subagent completed: {sessionTitle}",
    "error": "Error occurred: {sessionTitle}",
    "question": "Question from assistant: {sessionTitle}",
    "user_cancelled": "Cancelled by user: {sessionTitle}",
    "plan_exit": "Plan ready for review: {sessionTitle}",
    "session_started": "Session started: {sessionTitle}",
    "user_message": "User sent a message: {sessionTitle}",
    "client_connected": "OpenCode connected: {sessionTitle}"
  }
}
