{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:8931/mcp"
    },
    "ghidra": {
      "enabled": true,
      "type": "local",
      "command": [
        "ghidra-mcp-headless"
      ]
    },
    "ida-pro": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:8745/mcp?ext=dbg"
    },
    "ssh-mcp-server": {
      "enabled": true,
      "type": "local",
      "command": [
        "ssh-mcp-server",
        "--config-file",
        ".ssh-mcp-server.json"
      ]
    }
  }
}
