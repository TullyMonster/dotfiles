  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": {{ .opencode.mcp_context7_api_key | quote }}
      }
    },
    "exa-pool": {
      "enabled": false,
      "type": "local",
      "command": ["uv", "run", "--directory", "/home/tully/mcp-servers/exa-pool-mcp", "exa_pool_mcp.py"],
      "environment": {
        "EXA_POOL_BASE_URL": {{ .opencode.mcp_exa_pool_base_url | quote }},
        "EXA_POOL_API_KEY": {{ .opencode.mcp_exa_pool_api_key | quote }}
      }
    },
    "ace-tool": {
      "enabled": true,
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "ace-tool",
        "--base-url",
        {{ .opencode.mcp_ace_tool_base_url | quote }},
        "--token",
        {{ .opencode.mcp_ace_tool_token | quote }}
      ]
    },
    "tavily": {
      "enabled": true,
      "type": "remote",
      "url": {{ printf "https://mcp.tavily.com/mcp/?tavilyApiKey=%s" .opencode.mcp_tavily_api_key | quote }}
    },
    "deepwiki": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "chrome-mcp": {
      "enabled": true,
      "type": "remote",
      "url": {{ .opencode.mcp_chrome_mcp_url | quote }}
    }
  }
}
