{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "cc-safety-net@latest",
    "@cortexkit/opencode-magic-context@latest",
    "@dietrichgebert/ponytail@latest",
    "@slkiser/opencode-quota@latest"
  ],
  "update": "disable",
  "agents": {
    "title": {
      "model": "deepseek/deepseek-flash#none",
      "mode": "primary",
      "description": "Generate a short title from the conversation for the list; background-only, not part of regular chat."
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "formatter": {
    "ruff": {
      "command": [
        "ruff",
        "format",
        "$FILE"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ],
      "disabled": false
    },
    "prettier": {
      "command": [
        "prettier",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".html",
        ".htm",
        ".css",
        ".scss",
        ".sass",
        ".less",
        ".vue",
        ".svelte",
        ".yaml",
        ".yml",
        ".toml",
        ".xml",
        ".md",
        ".mdx",
        ".graphql",
        ".gql"
      ],
      "disabled": false
    },
    "biome": {
      "command": [
        "biome",
        "format",
        "--write",
        "--json-formatter-expand=always",
        "--json-formatter-trailing-commas=none",
        "--json-formatter-indent-style=space",
        "--json-formatter-indent-width=2",
        "$FILE"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ],
      "disabled": false
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": {{ .mcp.context7_api_key | quote }}
        }
      },
      "ace": {
        "disabled": false,
        "type": "local",
        "command": [
          "ace-tool",
          "--base-url",
          {{ .mcp.ace_base_url | quote }},
          "--token",
          {{ .mcp.ace_token | quote }},
          "--no-webbrowser-enhance-prompt"
        ]
      },
      "fast-context": {
        "disabled": false,
        "type": "local",
        "command": [
          "fast-context-mcp"
        ],
        "environment": {
          "WINDSURF_API_KEY": {{ .mcp.windsurf_api_key | quote }},
          "FC_HIDE_EXTRACT_WINDSURF_KEY_TOOL": "true"
        }
      },
      "tavily": {
        "disabled": false,
        "type": "remote",
        "url": {{ printf "https://mcp.tavily.com/mcp/?tavilyApiKey=%s" .mcp.tavily_api_key | quote }}
      },
      "deepwiki": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      }
    }
  }
}
