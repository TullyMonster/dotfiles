  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": {{ .opencode.mcp_context7_api_key | quote }}
      }
    },
    "exa": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": {{ .opencode.mcp_exa_api_key | quote }}
      }
    },
    "ace": {
      "enabled": true,
      "type": "local",
      "command": [
        "ace-tool",
        "--base-url",
        {{ .opencode.mcp_ace_base_url | quote }},
        "--token",
        {{ .opencode.mcp_ace_token | quote }},
        "--no-webbrowser-enhance-prompt"
      ],
      "timeout": 8000
    },
    "tavily": {
      "enabled": true,
      "type": "remote",
      "url": {{ printf "https://mcp.tavily.com/mcp/?tavilyApiKey=%s" .opencode.mcp_tavily_api_key | quote }}
    },
    "deepwiki": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "chrome-mcp": {
      "enabled": true,
      "type": "remote",
      "url": {{ .opencode.mcp_chrome_mcp_url | quote }}
    }
  }
}
