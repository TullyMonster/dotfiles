{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent@latest", "cc-safety-net@latest", "@tarquinen/opencode-dcp@latest", "opencode-supermemory@latest"],
  "autoupdate": false,
  "small_model": "deepseek/deepseek-chat",
  "formatter": {
    "ruff": {
      "command": ["uvx", "ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"],
      "disabled": false
    },
    "prettier": {
      "command": ["bunx", "prettier", "--write", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".html",
        ".htm",
        ".css",
        ".scss",
        ".sass",
        ".less",
        ".vue",
        ".svelte",
        ".json",
        ".jsonc",
        ".yaml",
        ".yml",
        ".toml",
        ".xml",
        ".md",
        ".mdx",
        ".graphql",
        ".gql"
      ],
      "disabled": false
    }
  },
  "disabled_providers": ["easy", "lanyi"],
  "provider": {
    "ccwu": {
      "name": "ccwu API",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://claudeapi.ccwu.cc/v1"
      },
      "models": {
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16284
            }
          },
          "variants": {
            "low": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 8192
              }
            },
            "max": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 32768
              }
            }
          },
          "attachment": true
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
