{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "keybinds": {
    "app.exit": "ctrl+d",
    "prompt.editor": "none",
    "session.page.up": "pageup",
    "session.page.down": "pagedown",
    "session.line.up": "none",
    "session.line.down": "none",
    "session.half.page.up": "none",
    "session.half.page.down": "none",
    "session.first": "ctrl+pageup",
    "session.last": "ctrl+pagedown",
    "session.message.next": "ctrl+down",
    "session.message.previous": "ctrl+up",
    "prompt.clear": "ctrl+c",
    "input.submit": "return",
    "input.newline": "ctrl+j",
    "input.move.left": "left",
    "input.move.right": "right",
    "input.move.up": "up",
    "input.move.down": "down",
    "input.line.home": "home",
    "input.line.end": "end",
    "input.select.line.home": "none",
    "input.select.line.end": "none",
    "input.visual.line.home": "none",
    "input.visual.line.end": "none",
    "input.select.visual.line.home": "none",
    "input.select.visual.line.end": "none",
    "input.buffer.home": "ctrl+home",
    "input.buffer.end": "ctrl+end",
    "input.delete.line": "none",
    "input.backspace": "backspace",
    "input.delete": "delete",
    "input.undo": "alt+9",
    "input.redo": "alt+0",
    "input.word.forward": "ctrl+right",
    "input.word.backward": "ctrl+left",
    "input.select.word.forward": "none",
    "input.select.word.backward": "none",
    "input.delete.word.forward": "none",
    "input.delete.word.backward": "none"
  },
  "plugins": [
    "@cortexkit/opencode-magic-context@latest",
    "@slkiser/opencode-quota@latest",
    "opencode-subagent-magazine@latest",
    "opencode-visual-cache@latest",
    "-opencode.sidebar.context"
  ]
}
