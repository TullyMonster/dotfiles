{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "opencode",
  "keybinds": {
    "app_exit": "ctrl+d",
    "messages_page_up": "pageup",
    "messages_page_down": "pagedown",
    "messages_first": "ctrl+pageup",
    "messages_last": "ctrl+pagedown",
    "messages_previous": "ctrl+up",
    "messages_next": "ctrl+down",
    "input_clear": "ctrl+c",
    "input_move_left": "left",
    "input_move_right": "right",
    "input_move_up": "up",
    "input_move_down": "down",
    "input_word_forward": "ctrl+right",
    "input_word_backward": "ctrl+left",
    "input_line_home": "home",
    "input_line_end": "end",
    "input_buffer_home": "ctrl+home",
    "input_buffer_end": "ctrl+end",
    "input_backspace": "backspace",
    "input_delete": "delete",
    "input_undo": "alt+9",
    "input_redo": "alt+0",
    "input_newline": "ctrl+j",
    "input_submit": "return",
    "editor_open": "none",
    "messages_line_up": "none",
    "messages_line_down": "none",
    "messages_half_page_up": "none",
    "messages_half_page_down": "none",
    "input_select_line_home": "none",
    "input_select_line_end": "none",
    "input_visual_line_home": "none",
    "input_visual_line_end": "none",
    "input_select_visual_line_home": "none",
    "input_select_visual_line_end": "none",
    "input_select_word_forward": "none",
    "input_select_word_backward": "none",
    "input_delete_word_forward": "none",
    "input_delete_word_backward": "none",
    "input_delete_line": "none"
  },
  "plugin": [
    "oh-my-openagent@latest",
    [
      "opencode-visual-cache@latest",
      {
        "enabled": true
      }
    ],
    [
      "opencode-subagent-magazine@latest",
      {
        "enabled": true
      }
    ]
  ]
}
