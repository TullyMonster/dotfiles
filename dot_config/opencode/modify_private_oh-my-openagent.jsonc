#!/usr/bin/env -S bun run --install=fallback --loader .jsonc:js

import { applyEdits, modify, parse } from "jsonc-parser@^3.0.0";

const source = await Bun.stdin.text();
const errors = [];
const current = parse(source, errors, { allowTrailingComma: true });

if (errors.length > 0) {
  console.error(`Invalid JSONC: ${errors.length} parse error(s)`);
  process.exit(1);
}

let output = source;
for (const [key, value] of Object.entries(
  Bun.JSONC.parse(
    await Bun.file(
      `${Bun.env.CHEZMOI_SOURCE_DIR}/.chezmoidata/oh-my-openagent-static.jsonc`,
    ).text(),
  ).oh_my_openagent,
)) {
  if (JSON.stringify(current[key]) !== JSON.stringify(value)) {
    output = applyEdits(
      output,
      modify(output, [key], value, {
        formattingOptions: { insertSpaces: true, tabSize: 2, eol: "\n" },
      }),
    );
  }
}

if (!output.endsWith("\n")) {
  output += "\n";
}

process.stdout.write(output);
