set autoindent          # 新行自动继承上一行的缩进
set smarthome           # Home 键先跳行首非空字符
set linenumbers         # 显示行号
set trimblanks          # 自动硬换行或文本对齐时，删除被折断行末尾的空白字符
set tabsize 4           # Tab 宽度为 4
set tabstospaces        # Tab 转空格
set constantshow        # 持续在状态栏显示光标位置
set positionlog         # 记住关闭文件时的光标位置
set historylog          # 记录搜索和替换历史，以便复用
set indicator           # 显示滚动条

unset casesensitive     # 搜索时大小不敏感（Alt + C）
unset softwrap          # 禁用软换行（Alt + S）
unset mouse             # 禁用鼠标点击定位（Alt + M）
