[Unit]
Description=OpenChamber Web
Documentation=https://docs.openchamber.dev/
Wants=opencode.service
After=network.target opencode.service

[Service]
Type=simple
Environment=PATH=%h/.local/share/mise/shims:/usr/bin:/bin
Environment=OPENCODE_SKIP_START=true
Environment=OPENCHAMBER_ALLOW_REMOTE_OPENAI_COMPAT_URLS=true
ExecStart=%h/.local/libexec/openchamber/serve
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
