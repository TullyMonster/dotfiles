#!/usr/bin/env sh

set -eu

_state_file="${XDG_STATE_HOME:-${HOME}/.local/state}/opencode/service.json"
_ready_timeout=30

info() { printf '%s\n' "$*" >&2; }
fatal() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

_read_service() {
  [ -r "${_state_file}" ] || return 1
  _svc_out=$(
  jq -er '
      select(.pid and .url and .password)
      | [.pid, .url, .password] | map(tostring) | .[]
    ' "${_state_file}" 2> /dev/null
) || return 1
  {
    IFS= read -r _svc_pid
    IFS= read -r _svc_url
    IFS= read -r _svc_password
  } << EOF
${_svc_out}
EOF
}

_is_opencode_ready() {
  _read_service || return 1
  kill -0 "${_svc_pid}" 2> /dev/null || return 1
  curl -fsS --max-time 2 -u "opencode:${_svc_password}" "${_svc_url}/api/info" > /dev/null 2>&1
}

if ! _is_opencode_ready; then
  info 'Starting OpenCode background service'
  systemctl --user restart opencode.service

  _waited=0
  until _is_opencode_ready; do
    [ "${_waited}" -lt "${_ready_timeout}" ] ||
      fatal "OpenCode background service not ready after ${_ready_timeout}s"
    _waited=$((_waited + 1))
    sleep 1
  done
fi

export OPENCODE_HOST="${_svc_url}"
export OPENCODE_SERVER_PASSWORD="${_svc_password}"

exec openchamber serve --foreground --hostname 127.0.0.1 --port 3000
