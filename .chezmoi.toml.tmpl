{{- $keyPath := joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt" -}}
{{- if not (stat $keyPath) -}}
    {{- fail "ERROR: Age private key not found. Please restore it to ~/.config/chezmoi/key.txt first." -}}
{{- end -}}

encryption = "age"

[age]
recipient = {{ trim (output .chezmoi.executable "age-keygen" "-y" $keyPath) | quote }}
identity  = {{ $keyPath                                           | quote }}

[diff]
exclude = ["scripts"]

[data.zsh]
zdotdir = {{ joinPath .chezmoi.homeDir ".config" "zsh" | quote }}

[data.git]
user_signing_key = {{ promptStringOnce . "git.user_signing_key" "Git: SSH signing public key path" | quote }}

[data.systemd.user]
is_reload_after_apply = {{ promptBoolOnce . "systemd.user.is_reload_after_apply" "systemd user: Reload the user manager after apply" true }}

[data.npm]
is_using_mirror = {{ promptBoolOnce . "npm.is_using_mirror" "NPM: Use a registry mirror on this device" false }}

[data.sub_store]
backend_path = {{ promptStringOnce . "sub_store.backend_path" "Sub-Store: SUB_STORE_FRONTEND_BACKEND_PATH" | quote }}

[data.mcp]
context7_api_key    = {{ promptStringOnce . "mcp.context7_api_key"    "MCP: CONTEXT7_API_KEY"                                                                               | quote }}
tavily_api_key      = {{ promptStringOnce . "mcp.tavily_api_key"      "MCP: tavilyApiKey"                                                                                   | quote }}
windsurf_api_key    = {{ promptStringOnce . "mcp.windsurf_api_key"    "MCP: WINDSURF_API_KEY"                                                                               | quote }}
ida_pro_dir         = {{ promptStringOnce . "mcp.ida_pro_dir"         "MCP: IDA Pro directory"                     (joinPath .chezmoi.homeDir ".local" "opt" "ida-pro-9.3") | quote }}
