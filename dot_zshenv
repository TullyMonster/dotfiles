# =============================================================================
# .zshenv
# 所有 Zsh 实例在脚本式、交互式、登录式都会最先加载加载
#
# 适合写入：
#   - 所有 Shell 类型都需要的环境变量
#   - 工具路径
# =============================================================================

# XDG 基础目录
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"      # 用户级配置文件目录
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"         # 用户级缓存文件目录
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"     # 用户级应用数据目录
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"   # 用户级状态数据目录

# Zsh 目录
export ZDOTDIR="$HOME/.config/zsh"                  # .zprofile、.zshrc、.zlogin、.zlogout 路径
export SITE_FUNCTIONS="$ZDOTDIR/site-functions"     # 第三方补全脚本路径

# 系统行为
export SUDO_AS_ADMIN_SUCCESSFUL=1   # 阻止 sudo 创建 .sudo_as_admin_successful 文件

# 语言与本地化
export LANG="en_US.UTF-8"           # 系统语言环境
export LC_CTYPE="en_US.UTF-8"       # 字符分类与大小写处理
export LC_MESSAGES="en_US.UTF-8"    # 系统消息语言

# 编辑器
export EDITOR=micro     # 默认的行编辑器
export VISUAL=micro     # 默认的全屏编辑器

# 补全系统控制与缓存
export skip_global_compinit=1                                                       # 跳过 /etc/zsh/zshrc 中的 compinit 初始化
export ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-${ZSH_VERSION}"  # 补全系统缓存路径

# OpenCode
export OPENCODE_DISABLE_CLAUDE_CODE=1   # 禁用对 Claude Code 的回退性兼容
export OPENSPEC_TELEMETRY=0             # 禁用 OpenSpec 遥测
export OMO_SEND_ANONYMOUS_TELEMETRY=0   # 禁用 oh-my-openagent 遥测

# 命令与函数搜索路径
typeset -U path fpath
path=(
    /usr/local/bin                  # 系统级手动安装的程序
    $HOME/bin                       # 用户自定义脚本目录
    $HOME/.local/bin                # 用户级安装的程序
    $HOME/.local/share/pnpm/bin     # pnpm 全局安装包的 bin 目录
    $HOME/.cargo/bin                # Rust 工具链
    $HOME/.go/bin                   # Go 工具
    $path
)
fpath=(
    $SITE_FUNCTIONS
    $fpath
)
