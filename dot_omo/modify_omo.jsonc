#!/usr/bin/env -S bun run --install=fallback --loader .jsonc:js

import { applyEdits, modify, parse } from "jsonc-parser@^3.0.0";

let targetConfigText = (await Bun.stdin.text()) || "{}\n";
const parseErrors = [];
const existingConfig = parse(targetConfigText, parseErrors);

if (parseErrors.length > 0) {
  console.error(`Invalid JSONC: ${parseErrors.length} parse error(s)`);
  process.exit(1);
}

const templateResult = Bun.spawnSync([
  "chezmoi",
  "execute-template",
  "{{ .omo | toJson }}",
]);

if (!templateResult.success) {
  console.error(
    templateResult.stderr.toString().trim() ||
      "chezmoi execute-template failed",
  );
  process.exit(1);
}

const updateConfigValue = (path, value) => {
  const existingValue = path.reduce(
    (config, key) => config?.[key],
    existingConfig,
  );

  if (JSON.stringify(existingValue) === JSON.stringify(value)) return;

  targetConfigText = applyEdits(
    targetConfigText,
    modify(targetConfigText, path, value, {
      formattingOptions: { insertSpaces: true, tabSize: 2, eol: "\n" },
    }),
  );
};

for (const [key, value] of Object.entries(
  JSON.parse(templateResult.stdout.toString()),
)) {
  if (key === "[opencode]") {
    for (const [opencodeKey, opencodeValue] of Object.entries(value)) {
      updateConfigValue([key, opencodeKey], opencodeValue);
    }
  } else {
    updateConfigValue([key], value);
  }
}

process.stdout.write(
  targetConfigText.endsWith("\n") ? targetConfigText : `${targetConfigText}\n`,
);
