{{- if and (eq .chezmoi.os "linux") (lookPath "systemctl") $.systemd.user.is_reload_after_apply -}}
#!/usr/bin/env sh

# ==================================================
# 重新加载用户级 systemd 单元配置
# ==================================================

# {{ includeTemplate "dot_config/systemd/user/ida-pro-mcp.service.tmpl" . | sha256sum }}
# {{ includeTemplate "dot_config/systemd/user/opencode-server.service.tmpl" . | sha256sum }}
# {{ includeTemplate "dot_config/containers/systemd/headed-playwright-browser-profile.volume.tmpl" . | sha256sum }}
# {{ includeTemplate "dot_config/containers/systemd/headed-playwright-service.container.tmpl" . | sha256sum }}
# {{ includeTemplate "dot_config/containers/systemd/sub-store.container.tmpl" . | sha256sum }}

set -eu

warn() {
  printf 'warning: %s\n' "$*" >&2
}

if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

if systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload
else
  warn 'no systemd user instance available; skipping daemon-reload'
fi
{{- end }}
