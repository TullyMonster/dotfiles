{{- if and (eq .chezmoi.os "linux") (lookPath "loginctl") -}}
#!/usr/bin/env sh

# ==================================================
# 启用 systemd 用户逗留
# ==================================================

set -eu

. "${HOME}/.local/lib/shell/log.sh"

user="$(id -un)"

if ! linger="$(loginctl show-user "${user}" --property=Linger --value 2>/dev/null)"; then
  fatal 'logind is unavailable; cannot enable linger.'
fi

if [ "${linger}" != "yes" ]; then
  loginctl enable-linger "${user}"
fi
{{- end }}
