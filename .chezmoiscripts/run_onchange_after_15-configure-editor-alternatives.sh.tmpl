{{- if and (eq .chezmoi.os "linux") (lookPath "update-alternatives") (lookPath "sudo") -}}
#!/usr/bin/env sh

# ==================================================
# 将系统编辑器命令统一到同一编辑器
# ==================================================

set -eu

wrapper='{{ .chezmoi.homeDir }}/.local/libexec/nvim/wrapper'

for group in editor vi vim view vimdiff; do
  sudo update-alternatives --remove "${group}" "${wrapper}"
  prio=$(update-alternatives --query "${group}" 2> /dev/null | awk '/^Priority: / { if ($2 > max) max = $2 } END { print max + 10 - max % 10 }')
  sudo update-alternatives --install "/usr/bin/${group}" "${group}" "${wrapper}" "${prio}"
  sudo update-alternatives --auto "${group}"
done
{{- end }}
